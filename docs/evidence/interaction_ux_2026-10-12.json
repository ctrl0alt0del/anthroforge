  "experiment": {
    "description": "During publish_muscle_work collect non-explicit muscle_pairs.runtime.refresh requests by scene/root, then refresh each once at batch exit. Keep remember calls and geometry publication. Patch the imported publish alias in muscle_sync too. Observed 24 deferred requests across two edits.",
    "script": "import bpy\nimport hashlib\nimport json\nimport numpy as np\nfrom pathlib import Path\nimport runpy\nimport sys\nsys.path.insert(0, r'C:\\Users\\alexe\\AppData\\Roaming\\Blender Foundation\\Blender\\5.0\\scripts\\addons')\nimport anthroforge\nanthroforge.register()\nbpy.ops.wm.open_mainfile(filepath=r'E:\\development\\WIP_models\\skull_muscles.blend')\nfrom anthroforge.core.muscle_pairs import runtime\nfrom anthroforge.core.visualization import muscle_numeric_runtime, muscle_sync\noriginal_refresh = runtime.refresh\noriginal_publish = muscle_numeric_runtime.publish_muscle_work\nbatch = {'depth': 0, 'pending': {}, 'deferred': 0}\n\ndef deferred_refresh(scene, root, explicit=False):\n    if batch['depth'] and not explicit:\n        batch['pending'][(scene.name, root.name)] = (scene, root)\n        batch['deferred'] += 1\n        return\n    return original_refresh(scene, root, explicit)\n\ndef batched_publish(*args, **kwargs):\n    batch['depth'] += 1\n    try:\n        return original_publish(*args, **kwargs)\n    finally:\n        batch['depth'] -= 1\n        if not batch['depth']:\n            rows = tuple(batch['pending'].values())\n            batch['pending'].clear()\n            for scene, root in rows:\n                original_refresh(scene, root)\n\nif Path(__file__).stem == 'batched':\n    runtime.refresh = deferred_refresh\n    muscle_numeric_runtime.publish_muscle_work = batched_publish\n    muscle_sync.publish_muscle_work = batched_publish\n\ndef mesh_digest(obj):\n    vertices = np.empty(len(obj.data.vertices)*3, dtype=np.float32)\n    loops = np.empty(len(obj.data.loops), dtype=np.int32)\n    counts = np.empty(len(obj.data.polygons), dtype=np.int32)\n    obj.data.vertices.foreach_get('co', vertices)\n    obj.data.loops.foreach_get('vertex_index', loops)\n    obj.data.polygons.foreach_get('loop_total', counts)\n    payload = vertices.tobytes()+loops.tobytes()+counts.tobytes()\n    payload += np.asarray(obj.matrix_world, dtype=np.float64).