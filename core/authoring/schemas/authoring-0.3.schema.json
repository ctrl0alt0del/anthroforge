  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:anthroforge:authoring:0.3.0",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
    },
    "xyz": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "q3": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 3,
      "maxItems": 3
    },
    "uv": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 2,
      "maxItems": 2
    },
    "evidence": {
      "type": "object",
      "properties": {
        "basis": {
          "enum": [
            "source_stated",
            "geometry_measured",
            "inferred",
            "designer_authored",
            "synthetic"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "basis",
        "sources",
        "note"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "text",
            "mesh",
            "simulation_model",
            "designer",
            "synthetic"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "title",
        "kind",
        "locator",
        "version",
        "license"
      ],
      "additionalProperties": false
    },
    "length": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "type": "number",
              "minimum": 0
            },
            "unit": {
              "enum": [
                "scene",
                "mm"
              ]
            }
          },
          "required": [
            "value",
            "unit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "fraction": {
              "type": "number",
              "minimum": 0
            },
            "of": {
              "enum": [
                "frame_extent"
              ]
            },
            "frame": {
              "$ref": "#/$defs/id"
            },
            "axis": {
              "enum": [
                "x",
                "y",
                "z"
              ]
            }
          },
          "required": [
            "fraction",
            "of",
            "frame",
            "axis"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "fraction": {
              "type": "number",
              "minimum": 0
            },
            "of": {
              "enum": [
                "reference_fiber_length",
                "reference_attachment_width"
              ]
            }
          },
          "required": [
            "fraction",
            "of"
          ],
          "additionalProperties": false
        }
      ]
    },
    "units": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "relative"
              ]
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "enum": [
                "metric"
              ]
            },
            "meters_per_scene_unit": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "mode",
            "meters_per_scene_unit"
          ],
          "additionalProperties": false
        }
      ]
    },
    "context": {
      "type": "object",
      "properties": {
        "reference_pose": {
          "$ref": "#/$defs/id"
        },
        "units": {
          "$ref": "#/$defs/units"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "example_only": {
          "type": "boolean"
        }
      },
      "required": [
        "reference_pose",
        "units",
        "scope",
        "example_only"
      ],
      "additionalProperties": false
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "scene_scp_id"
              ]
            },
            "id": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "semantic_query"
              ]
            },
            "concept": {
              "type": "string",
              "minLength": 1
            },
            "side": {
              "enum": [
                "left",
                "right",
                "midline"
              ]
            }
          },
          "required": [
            "kind",
            "concept",
            "side"
          ],
          "additionalProperties": false
        }
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "concept": {
          "type": "string",
          "minLength": 1
        },
        "side": {
          "enum": [
            "left",
            "right",
            "midline"
          ]
        },
        "binding": {
          "$ref": "#/$defs/binding"
        }
      },
      "required": [
        "concept",
        "side",
        "binding"
      ],
      "additionalProperties": false
    },
    "frame": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "owner": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "enum": [
                "anatomical_box"
              ]
            },
            "axes_owner_local": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/xyz"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "axis_labels": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 3,
              "maxItems": 3
            },
            "bounds": {
              "enum": [
                "evaluated_geometry_at_reference_pose"
              ]
            },
            "editor_grid": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          },
          "required": [
            "owner",
            "kind",
            "axes_owner_local",
            "axis_labels",
            "bounds",
            "editor_grid",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "owner": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "enum": [
                "landmark_box"
              ]
            },
            "axis_labels": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 3,
              "maxItems": 3
            },
            "bounds": {
              "enum": [
                "evaluated_geometry_at_reference_pose"
              ]
            },
            "editor_grid": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            },
            "landmarks_q": {
              "type": "object",
              "properties": {
                "origin": {
                  "$ref": "#/$defs/q3"
                },
                "x": {
                  "$ref": "#/$defs/q3"
                },
                "xy": {
                  "$ref": "#/$defs/q3"
                }
              },
              "required": [
                "origin",
                "x",
                "xy"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "owner",
            "kind",
            "axis_labels",
            "bounds",
            "editor_grid",
            "evidence",
            "landmarks_q"
          ],
          "additionalProperties": false
        }
      ]
    },
    "projection": {
      "type": "object",
      "properties": {
        "method": {
          "enum": [
            "ray"
          ]
        },
        "direction_in_frame": {
          "$ref": "#/$defs/xyz"
        },
        "expected_normal_in_frame": {
          "$ref": "#/$defs/xyz"
        },
        "min_normal_dot": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "search_distance": {
          "$ref": "#/$defs/length"
        },
        "hit_policy": {
          "enum": [
            "unique",
            "closest_seed"
          ]
        },
        "continuity": {
          "enum": [
            "single_sheet"
          ]
        },
        "max_surface_error": {
          "$ref": "#/$defs/length"
        },
        "max_samples": {
          "type": "integer",
          "minimum": 4,
          "maximum": 65536
        },
        "selection_margin": {
          "$ref": "#/$defs/length"
        },
        "charts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "domain": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "minItems": 1,
                "maxItems": 2
              },
              "direction_in_frame": {
                "$ref": "#/$defs/xyz"
              },
              "expected_normal_in_frame": {
                "$ref": "#/$defs/xyz"
              }
            },
            "required": [
              "domain",
              "direction_in_frame",
              "expected_normal_in_frame"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 32
        }
      },
      "required": [
        "method",
        "direction_in_frame",
        "expected_normal_in_frame",
        "min_normal_dot",
        "search_distance",
        "hit_policy",
        "continuity",
        "max_surface_error",
        "max_samples"
      ],
      "additionalProperties": false
    },
    "region_shape": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "point"
              ]
            },
            "seed": {
              "$ref": "#/$defs/q3"
            }
          },
          "required": [
            "kind",
