  "required": [
    "$schema",
    "dsl",
    "version",
    "document_id",
    "revision",
    "context",
    "sources",
    "targets",
    "frames",
    "regions",
    "recipes",
    "volume_presets",
    "policies",
    "muscles",
    "roster"
