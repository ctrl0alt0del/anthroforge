              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "end": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "start",
            "end"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "patch_segment"
              ]
            },
            "start": {
              "$ref": "#/$defs/uv"
            },
            "end": {
              "$ref": "#/$defs/uv"
            }
          },
          "required": [
            "kind",
            "start",
            "end"
          ],
          "additionalProperties": false
        }
      ]
    },
    "location": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "point"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "curve"
              ]
            },
            "t": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "t"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "patch"
              ]
            },
            "uv": {
              "$ref": "#/$defs/uv"
            }
          },
          "required": [
            "kind",
            "uv"
          ],
          "additionalProperties": false
        }
      ]
    },
    "station": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "s": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "role": {
          "enum": [
            "origin",
            "guide",
            "insertion"
