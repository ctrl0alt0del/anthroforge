                "$ref": "#/$defs/q3"
              },
              "minItems": 4,
              "maxItems": 4
            },
            "trim_uv": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/uv"
              },
              "minItems": 3
            }
          },
          "required": [
            "kind",
            "corners"
          ],
          "additionalProperties": false
        }
      ]
    },
    "region": {
      "type": "object",
      "properties": {
        "frame": {
          "$ref": "#/$defs/id"
        },
        "concept": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "enum": [
            "attachment",
            "route_touch",
            "landmark"
          ]
        },
        "definition": {
          "$ref": "#/$defs/region_shape"
        },
        "projection": {
          "$ref": "#/$defs/projection"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      },
      "required": [
        "frame",
        "concept",
        "purpose",
        "definition",
        "projection",
        "evidence"
      ],
      "additionalProperties": false
    },
    "role": {
      "type": "object",
      "properties": {
        "anatomical_target": {
          "type": "string",
          "minLength": 1
        },
        "region_kind": {
          "enum": [
            "point",
            "curve",
            "patch"
          ]
        },
        "purpose": {
          "enum": [
            "attachment",
            "route_touch",
            "landmark"
          ]
        }
      },
      "required": [
        "anatomical_target",
        "region_kind",
        "purpose"
      ],
      "additionalProperties": false
    },
    "sample": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "point"
              ]
            }
